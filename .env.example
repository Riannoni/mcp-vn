# Copy to .env, generate new strong secrets, NEVER commit .env.
# Public URL of the authenticated VPS reverse-proxy endpoint, WITHOUT /mcp.
VN_PUBLIC_ORIGIN=https://your-vn.example/vn

# Independent secrets. For each, use: openssl rand -hex 32
VN_WORKER_TOKEN=REPLACE_WITH_RANDOM_WORKER_TOKEN
VN_MCP_TOKEN=REPLACE_WITH_RANDOM_MCP_TOKEN
VN_ASSET_SECRET=REPLACE_WITH_RANDOM_ASSET_HMAC_SECRET
