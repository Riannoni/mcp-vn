[Unit]
Description=ComfyUI ROCm 7.2 for Radeon RX 9070 XT
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/mcp-vn-comfy:gfx1201
ContainerName=mcp-vn-comfy
Pull=never
PublishPort=127.0.0.1:8189:8188
AddDevice=/dev/kfd
AddDevice=/dev/dri
GroupAdd=keep-groups
SecurityLabelDisable=true
NoNewPrivileges=true
Environment=PYTORCH_ROCM_ARCH=gfx1201
Environment=HIP_ARCHITECTURES=gfx1201
Environment=HCC_AMDGPU_TARGET=gfx1201
Environment=PYTHONPATH=/data/vendor-python
Volume=/home/Xavok/.local/share/mcp-vn-comfy:/data:rw
ShmSize=2g
Exec=/bin/bash -lc "exec python3 $COMFYUI_PATH/main.py --listen 0.0.0.0 --port 8188 --disable-auto-launch --extra-model-paths-config /data/extra_model_paths.yaml --input-directory /data/input --output-directory /data/output --temp-directory /data/temp --user-directory /data/user"

[Service]
# Quadlet is a USER service; it cannot Requires= a SYSTEM firewall unit.
# Require a fresh root nft guard check before every 8189 backend restart,
# otherwise a boot-order race exposes the backend without the broker.
# Production rollout must provision Xavok passwordless check-only sudo first.
ExecStartPre=/usr/bin/sudo -n /usr/local/libexec/comfy-broker-firewall check
Restart=on-failure
RestartSec=8
TimeoutStartSec=180

[Install]
WantedBy=default.target
