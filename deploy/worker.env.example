# PC user service EnvironmentFile: ~/.config/mcp-vn/worker.env
# Copy and edit manually; this file is only an EXAMPLE.
# Token MUST equal VN_WORKER_TOKEN on the home server.
VN_SERVER=http://HOME_SERVER_LAN_IP:3100
VN_WORKER_TOKEN=REPLACE_WITH_SAME_WORKER_TOKEN
VN_LOCAL_ROUTER_TOKEN=REPLACE_WITH_SAME_WORKER_TOKEN

# Optional local services (not all are required in the base gateway).
COMFY_URL=http://127.0.0.1:8188
VN_VISION_URL=http://127.0.0.1:9312
VN_KOBOLD_BIND_HOST=PC_LAN_IP
VN_ASSET_CACHE_MIB=128
VN_CPU_WORKERS=2
VN_VISION_QA=1
VN_LOCAL_CG_CHECKPOINT=CyberRealisticPony_V18.0_F16.safetensors
